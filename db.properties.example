# =========================================================================
# Database Configuration Template (db.properties.example)
# =========================================================================
# Instructions:
# 1. Copy this file and name it 'db.properties'.
# 2. Adjust db.username and db.password to match your local MySQL installation.
# 3. Set db.enabled=true when your MySQL service is running.
# =========================================================================

db.enabled=true
db.url=jdbc:mysql://localhost:3306/event_management_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
db.password=your_mysql_password_here
db.driver=com.mysql.cj.jdbc.Driver
